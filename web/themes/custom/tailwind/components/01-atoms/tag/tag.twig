{% set variants = {
  neutral: 'bg-surface border border-border text-text hover:border-border-strong',
  primary: 'bg-primary/10 border border-primary text-primary hover:bg-primary/20',
} %}
{% set classes = [
  'inline-flex items-center gap-1 rounded-full text-sm px-3 py-1 no-underline transition-colors duration-150',
  variants[variant|default('neutral')],
] %}

{% if url %}
  <a href="{{ url }}"{{ attributes.addClass(classes) }}>
    {% block content %}{{ content|default('') }}{% endblock %}
    {% if removable %}{% include 'tailwind:icon' with { name: 'close', size: 'sm', decorative: false, label: 'Retirer'|t } only %}{% endif %}
  </a>
{% else %}
  <span{{ attributes.addClass(classes) }}>
    {{ block('content') }}
    {% if removable %}{% include 'tailwind:icon' with { name: 'close', size: 'sm', decorative: false, label: 'Retirer'|t } only %}{% endif %}
  </span>
{% endif %}
