{% set columns_classes = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
} %}
<div{{ attributes.addClass('grid gap-6', columns_classes[columns|default(3)]) }}>{% block items %}{{ items|default('') }}{% endblock %}</div>
